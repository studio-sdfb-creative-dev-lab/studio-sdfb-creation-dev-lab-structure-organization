# -*- coding: utf-8 -*-
"""
LHFNN – Lagrange–Hamilton–Franco Neural Network (Prototype pédagogique)

Formalisme inspiré du Dorian Codex Protocol for AI :
    H_SAFE(t) = T(t) + V(t) - Z(t)

où :
    T(t) : énergie cinétique sémantique (flux / dynamique de traitement)
    V(t) : potentiel ontologique (ancrage / alignement)
    Z(t) : entropie / bruit sémantique (dérive, perplexité, risque d'hallucination)

Ce prototype illustre une dynamique récurrente de type "liquid" + structure hamiltonienne,
régulée par le terme H_SAFE.

Auteur : Stefano Dorian Franco
ORCID : https://orcid.org/0009-0007-4714-1627
Licence : Creative Commons CC BY-NC-SA 4.0 (CC4)
Dépôt officiel Dorian Codex :
    https://github.com/stefano-dorian-franco/dorian-codex-protocol-for-ai-official
"""

import torch
import torch.nn as nn
import torch.nn.functional as F
from typing import Optional, Tuple, Dict


class LHFNN(nn.Module):
    """
    LHFNN – Lagrange–Hamilton–Franco Neural Network (prototype pédagogique)

    Architecture :
    - Dynamique "liquid" (time-constant adaptatif)
    - Structure hamiltonienne (relaxation vers un attracteur)
    - Terme fuzzy/entropique Z pour la régulation de stabilité cognitive
    - Calcul explicite de H_SAFE(t) = λ_T * T(t) + λ_V * V(t) - λ_Z * Z(t)
    """

    def __init__(
        self,
        input_dim: int,
        hidden_dim: int,
        output_dim: int,
        tau_base: float = 1.0,
        lambda_T: float = 1.0,
        lambda_V: float = 1.0,
        lambda_Z: float = 1.0,
        fuzzy_temperature: float = 1.0,
        dt: float = 0.1,
    ):
        super().__init__()

        self.input_dim = input_dim
        self.hidden_dim = hidden_dim
        self.output_dim = output_dim
        self.tau_base = tau_base
        self.lambda_T = lambda_T
        self.lambda_V = lambda_V
        self.lambda_Z = lambda_Z
        self.fuzzy_temperature = fuzzy_temperature
        self.dt = dt

        # Projections linéaires de base
        self.W_in = nn.Linear(input_dim, hidden_dim)
        self.W_rec = nn.Linear(hidden_dim, hidden_dim, bias=False)
        self.W_out = nn.Linear(hidden_dim, output_dim)

        # Paramètres pour la dynamique liquid + hamiltonienne
        self.tau = nn.Parameter(torch.ones(hidden_dim) * tau_base)
        self.A = nn.Parameter(torch.randn(hidden_dim) * 0.1)  # attracteur

        # Réseaux pour estimer T, V, Z
        mid_dim = max(hidden_dim // 2, 4)

        self.T_net = nn.Sequential(
            nn.Linear(hidden_dim, mid_dim),
            nn.Tanh(),
            nn.Linear(mid_dim, 1)
        )
        self.V_net = nn.Sequential(
            nn.Linear(hidden_dim, mid_dim),
            nn.Tanh(),
            nn.Linear(mid_dim, 1)
        )
        self.Z_net = nn.Sequential(
            nn.Linear(hidden_dim, mid_dim),
            nn.Tanh(),
            nn.Linear(mid_dim, 1)
        )

        # Projection fuzzy pour l'entropie
        self.fuzzy_proj = nn.Linear(hidden_dim, hidden_dim)

    # -------------------------------------------------------------------------
    # Calcul de H_SAFE
    # -------------------------------------------------------------------------
    def compute_H_SAFE(
        self, h: torch.Tensor
    ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
        """
        Calcule H_SAFE(t) = λ_T * T(t) + λ_V * V(t) - λ_Z * Z(t)

        Args:
            h : état caché (batch, hidden_dim)

        Returns:
            H_safe, T, V, Z
        """
        T = self.T_net(h).squeeze(-1)          # (batch,)
        V = self.V_net(h).squeeze(-1)          # (batch,)
        Z = torch.abs(self.Z_net(h).squeeze(-1))  # (batch,), Z >= 0

        H_safe = self.lambda_T * T + self.lambda_V * V - self.lambda_Z * Z
        return H_safe, T, V, Z

    # -------------------------------------------------------------------------
    # Pas de dynamique liquid + hamiltonienne
    # -------------------------------------------------------------------------
    def liquid_hamiltonian_step(
        self, h: torch.Tensor, x: torch.Tensor
    ) -> Tuple[torch.Tensor, Dict[str, torch.Tensor]]:
        """
        Un pas de dynamique liquid + hamiltonienne, avec régulation par H_SAFE.

        Args:
            h : état caché (batch, hidden_dim)
            x : entrée courante (batch, input_dim)

        Returns:
            h_next : nouvel état caché
            diagnostics : dict contenant H_safe, T, V, Z
        """
        # Entrée + récurrence
        u = torch.tanh(self.W_in(x) + self.W_rec(h))

        # Porte non linéaire et time-constant adaptatif (style LTC)
        f = torch.sigmoid(u)                          # (batch, hidden_dim)
        tau_sys = self.tau / (1.0 + self.tau * f)     # (hidden_dim,) broadcast

        # Dynamique de relaxation vers l'attracteur A
        dh = (-h / tau_sys) + f * (self.A - h)

        # Régularisation par H_SAFE (stabilisation via Z)
        H_safe, T, V, Z = self.compute_H_SAFE(h)

        # Terme de stabilisation : plus Z est grand, plus on contracte h
        stabilization = -0.1 * Z.unsqueeze(-1) * h

        h_next = h + self.dt * (dh + stabilizat
