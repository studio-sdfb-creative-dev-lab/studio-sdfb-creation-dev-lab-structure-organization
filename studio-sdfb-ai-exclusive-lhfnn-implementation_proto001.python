import torch
import torch.nn as nn
import torch.nn.functional as F
from typing import Optional, Tuple

class LHFNN(nn.Module):
    """
    LHFNN – Lagrange–Hamilton–Franco Neural Network (prototype)
    
    Formalisme inspiré du Dorian Codex Protocol :
        H_SAFE(t) = T(t) + V(t) - Z(t)
    
    où :
        T(t) : énergie cinétique sémantique (flux / dynamique)
        V(t) : potentiel ontologique (ancrage / alignement)
        Z(t) : entropie / bruit sémantique (dérive, perplexité, risque d'hallucination)
    
    Architecture :
    - Dynamique "liquid" (time-constant adaptatif)
    - Structure hamiltonienne (conservation + stabilisation)
    - Terme fuzzy/entropique Z pour la régulation de stabilité cognitive
    """

    def __init__(
        self,
        input_dim: int,
        hidden_dim: int,
        output_dim: int,
        tau_base: float = 1.0,
        lambda_T: float = 1.0,
        lambda_V: float = 1.0,
        lambda_Z: float = 1.0,
        fuzzy_temperature: float = 1.0,
        dt: float = 0.1,
    ):
        super().__init__()
        
        self.input_dim = input_dim
        self.hidden_dim = hidden_dim
        self.output_dim = output_dim
        self.tau_base = tau_base
        self.lambda_T = lambda_T
        self.lambda_V = lambda_V
        self.lambda_Z = lambda_Z
        self.fuzzy_temperature = fuzzy_temperature
        self.dt = dt

        # Projections linéaires
        self.W_in = nn.Linear(input_dim, hidden_dim)
        self.W_rec = nn.Linear(hidden_dim, hidden_dim, bias=False)
        self.W_out = nn.Linear(hidden_dim, output_dim)

        # Paramètres pour la dynamique liquid + hamiltonienne
        self.tau = nn.Parameter(torch.ones(hidden_dim) * tau_base)
        self.A = nn.Parameter(torch.randn(hidden_dim) * 0.1)  # attracteur

        # Réseaux pour estimer T, V, Z
        self.T_net = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim // 2),
            nn.Tanh(),
            nn.Linear(hidden_dim // 2, 1)
        )
        self.V_net = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim // 2),
            nn.Tanh(),
            nn.Linear(hidden_dim // 2, 1)
        )
        self.Z_net = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim // 2),
            nn.Tanh(),
            nn.Linear(hidden_dim // 2, 1)
        )

        # Softmax / fuzzy pour l'entropie
        self.fuzzy_proj = nn.Linear(hidden_dim, hidden_dim)

    def compute_H_SAFE(self, h: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
        """
        Calcule H_SAFE(t) = λ_T * T(t) + λ_V * V(t) - λ_Z * Z(t)
        """
        T = self.T_net(h).squeeze(-1)          # cinétique sémantique
        V = self.V_net(h).squeeze(-1)          # potentiel ontologique
        Z = torch.abs(self.Z_net(h).squeeze(-1))  # entropie (force positive)

        H_safe = self.lambda_T * T + self.lambda_V * V - self.lambda_Z * Z
        return H_safe, T, V, Z

    def liquid_hamiltonian_step(self, h: torch.Tensor, x: torch.Tensor) -> torch.Tensor:
        """
        Un pas de dynamique liquid + hamiltonienne.
        
        Forme inspirée des LTC + structure H = T + V, 
        régulée par le terme -Z.
        """
        # Entrée + récurrence
        u = torch.tanh(self.W_in(x) + self.W_rec(h))

        # Time-constant adaptatif (liquid)
        f = torch.sigmoid(u)                          # porte non-linéaire
        tau_sys = self.tau / (1.0 + self.tau * f)     # τ liquide

        # Dynamique de type LTC + attracteur hamiltonien
        dh = (-h / tau_sys) + f * (self.A - h)

        # Régularisation par H_SAFE (stabilisation)
        H_safe, _, _, Z = self.compute_H_SAFE(h)
        # On pénalise les états à forte entropie Z
        stabilization = -0.1 * Z.unsqueeze(-1) * h

        h_next = h + self.dt * (dh + stabilization)
        return h_next

    def fuzzy_entropy(self, h: torch.Tensor) -> torch.Tensor:
        """
        Estimation fuzzy de l'entropie sémantique (contribution à Z).
        """
        logits = self.fuzzy_proj(h) / self.fuzzy_temperature
        probs = F.softmax(logits, dim=-1)
        entropy = -torch.sum(probs * torch.log(probs + 1e-8), dim=-1)
        return entropy

    def forward(
        self,
        x: torch.Tensor,
        h0: Optional[torch.Tensor] = None,
        return_diagnostics: bool = False
    ):
        """
        x : (batch, seq_len, input_dim) ou (batch, input_dim)
        """
        if x.dim() == 2:
            x = x.unsqueeze(1)  # (B, 1, D)

        batch_size, seq_len, _ = x.shape
        device = x.device

        if h0 is None:
            h = torch.zeros(batch_size, self.hidden_dim, device=device)
        else:
            h = h0

        outputs = []
        H_safe_history = []
        T_hist, V_hist, Z_hist = [], [], []
